# ---- Supabase (server-side) ----
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Alternativas que el código también acepta:
# NEXT_PUBLIC_SUPABASE_URL=
# SUPABASE_SECRET_KEY=

# ---- Sesión admin ----
# Clave para firmar el JWT de sesión (jose, HS256)
SESSION_SECRET=
# Credenciales del único admin (no hay tabla de usuarios)
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ---- Cloudinary (imágenes de proyectos) ----
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
NEXT_PUBLIC_CLOUDINARY_CLOUD_APY_KEY=
CLOUDINARY_CLOUD_APY_SECRET=

# ---- Resend (formulario de contacto) ----
RESEND_API_KEY=

# ---- Google Maps (sección contacto) ----
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# ---- GitHub (opcional) ----
# Token para subir el rate limit al recalcular skills desde los repos
# de los proyectos (sin token: 60 req/hora por IP).
GITHUB_TOKEN=

# ---- Base URLs ----
NEXT_PUBLIC_BACKEND_URL=
NEXT_PUBLIC_FRONTEND_URL=
